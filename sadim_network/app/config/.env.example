# Database / app secrets live in .env — never commit real keys.

# --- Sadeem AI providers (server-side only) ---
# Order used for automatic fallback when a provider fails:
SADEEM_AI_PROVIDER_ORDER=gemini,openai,anthropic
# Optional manual default:
# SADEEM_AI_PROVIDER=gemini

# Google Gemini (existing)
GEMINI_API_KEY_1=replace-with-server-secret
GEMINI_API_KEY_2=replace-with-server-secret
GEMINI_MODEL=gemini-2.0-flash
# Legacy aliases still supported: API_KEY1 / API_KEY2

# OpenAI-compatible
# OPENAI_API_KEY=replace-with-server-secret
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# ANTHROPIC_API_KEY=replace-with-server-secret
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

SADEEM_AI_DAILY_LIMIT=20
SADEEM_AI_GUEST_DAILY_LIMIT=8
SADEEM_AI_MAX_UPLOAD_MB=5
